<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="256dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/thumb"
        android:layout_width="256dp"
        android:layout_height="144dp"
        android:background="@drawable/bg_card"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_focus">

        <ImageView
            android:id="@+id/epImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dim_card"
            android:duplicateParentState="true" />

        <ImageView
            android:id="@+id/epPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/btn_round"
            android:padding="12dp"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/epWatched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/badge_live"
            android:backgroundTint="#CC141414"
            android:fontFamily="@font/inter_bold"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="✓ VU"
            android:textColor="@color/text"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/epNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/badge_live"
            android:fontFamily="@font/inter_bold"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="À SUIVRE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/epProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/progress_red"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/epTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:singleLine="true"
        android:textColor="@color/nav_fg"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/epMeta"
        style="@style/Text.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textColor="@color/text3"
        android:textSize="12sp" />
</LinearLayout>
