<resources>
    <!-- Thème : noir chaud, polices Inter, transitions en fondu -->
    <style name="Theme.Flux" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/red</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:textViewStyle">@style/Text</item>
        <item name="android:editTextStyle">@style/Field</item>
        <item name="android:windowAnimationStyle">@style/FadeAnimations</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="alertDialogTheme">@style/Dialog</item>
    </style>

    <style name="Theme.Flux.Player">
        <item name="android:windowBackground">@color/bg_deep</item>
    </style>

    <style name="Theme.Flux.Splash">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textViewStyle">@style/Text</item>
    </style>

    <style name="FadeAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_in</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_back_in</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_back_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/screen_in</item>
        <item name="android:taskOpenExitAnimation">@anim/screen_out</item>
    </style>

    <!-- Typographie -->
    <style name="Text" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Display">
        <item name="android:fontFamily">@font/display_bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">18</item>
        <item name="android:shadowDy">2</item>
    </style>
    <style name="Text.Title">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Text.RowTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#E5E5E5</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Text.Meta">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="Text.Body">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#DDDDDA</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Text.Kicker">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.35</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Boutons "pilule" façon Netflix : gris translucide, blanc au focus -->
    <style name="PillBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="PillIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:tint">@color/on_btn</item>
    </style>
    <style name="PillText" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_btn</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="RoundBtn">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/btn_round</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:tint">@color/on_btn</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Field" parent="android:Widget.EditText">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:singleLine">true</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="NavIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:tint">@color/nav_fg</item>
    </style>
    <style name="NavLabel" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">22dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nav_fg</item>
        <item name="android:singleLine">true</item>
        <item name="android:alpha">0</item>
    </style>
    <style name="CtlBtn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/ctl_btn</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:tint">@color/on_btn</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
